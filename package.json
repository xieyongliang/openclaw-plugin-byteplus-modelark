{
  "name": "openclaw-plugin-byteplus-modelark",
  "version": "0.1.0",
  "description": "OpenClaw plugin for BytePlus Seedream image generation and Seedance video generation via ARK API",
  "type": "module",
  "license": "MIT",
  "author": "ByteDance",
  "repository": {
    "type": "git",
    "url": "https://github.com/xieyongliang/openclaw-plugin-byteplus-modelark.git"
  },
  "homepage": "https://github.com/xieyongliang/openclaw-plugin-byteplus-modelark#readme",
  "bugs": {
    "url": "https://github.com/xieyongliang/openclaw-plugin-byteplus-modelark/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "byteplus",
    "seedream",
    "seedance",
    "image-generation",
    "video-generation",
    "ai",
    "ark-api"
  ],
  "files": [
    "index.ts",
    "models.ts",
    "auth.ts",
    "seedream-tool.ts",
    "seedance-tool.ts",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "openai": "^6.32.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.22"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "openclaw-plugin-byteplus-modelark",
      "defaultChoice": "npm"
    },
    "compat": {
      "pluginApi": ">=2026.3.22"
    },
    "build": {
      "openclawVersion": "2026.3.24"
    }
  }
}
