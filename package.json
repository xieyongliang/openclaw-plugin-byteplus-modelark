{
  "name": "xieyongliang-byteplus-modelark",
  "version": "2026.4.11",
  "description": "OpenClaw plugin for BytePlus ARK API — Seed/Kimi/GLM language models, Seedream image generation, and Seedance video generation",
  "type": "module",
  "license": "MIT",
  "author": "ByteDance",
  "repository": {
    "type": "git",
    "url": "https://github.com/xieyongliang/openclaw-plugin-byteplus-modelark.git"
  },
  "homepage": "https://github.com/xieyongliang/openclaw-plugin-byteplus-modelark#readme",
  "bugs": {
    "url": "https://github.com/xieyongliang/openclaw-plugin-byteplus-modelark/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "byteplus",
    "seedream",
    "seedance",
    "image-generation",
    "video-generation",
    "ai",
    "ark-api"
  ],
  "files": [
    "index.ts",
    "models.ts",
    "auth.ts",
    "llm-models.ts",
    "llm-provider.ts",
    "seedream-tool.ts",
    "seedance-tool.ts",
    "seedance-provider.ts",
    "seedance2-provider.ts",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "openai": "^6.32.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.11"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "providers": [
      "byteplus-modelark",
      "byteplus-modelark-plan"
    ],
    "install": {
      "npmSpec": "xieyongliang-byteplus-modelark",
      "defaultChoice": "npm"
    },
    "compat": {
      "pluginApi": ">=2026.3.22"
    },
    "build": {
      "openclawVersion": "2026.4.11"
    }
  },
  "devDependencies": {
    "openclaw": "file:../openclaw"
  }
}
